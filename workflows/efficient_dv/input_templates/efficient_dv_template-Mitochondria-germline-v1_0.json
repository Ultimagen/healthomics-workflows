{
    "EfficientDV.base_file_name": "<base_file_name>",
    "EfficientDV.cram_files": [
        "<cram_file>.cram"
    ],
    "EfficientDV.cram_index_files": [
        "<cram_file>.cram.crai"
    ],
    "EfficientDV.num_shards": 1,
    "EfficientDV.make_gvcf": true,
    "EfficientDV.recalibrate_vaf": false,
    "EfficientDV.is_somatic": false,
    "EfficientDV.run_roh": false,
    "EfficientDV.single_strand_filter": true,
    "EfficientDV.min_fraction_single_strand_non_snps": 0.06,
    "EfficientDV.reference_genome": "hg38",
    "EfficientDV.preemptible_tries": 3,
    "EfficientDV.cap_at_optimal_coverage": false,
    "EfficientDV.normalize_strand_bias": false,
    "EfficientDV.ensemble_size": 0,
    "EfficientDV.strong_call_threshold": 0.995,
    "EfficientDV.sex_chromosomes": [
        "chrX",
        "chrY",
        "X",
        "Y"
    ],
    "EfficientDV.run_ploidy_estimation": false,
    "EfficientDV.shuffle_all_samples": false,
    "EfficientDV.model_onnx": "s3://ultimagen-workflow-resources-us-east-1/deepvariant/model/germline/segdup_1.0/model_dyn_1500.onnx",
    "EfficientDV.min_fraction_hmer_indels": 0.05,
    "EfficientDV.min_fraction_non_hmer_indels": 0.05,
    "EfficientDV.min_fraction_snps": 0.05,
    "EfficientDV.min_variant_quality_hmer_indels": 5,
    "EfficientDV.min_variant_quality_exome_hmer_indels": 5,
    "EfficientDV.min_variant_quality_non_hmer_indels": 0,
    "EfficientDV.min_variant_quality_snps": 0,
    "EfficientDV.optimal_coverages": [
        70
    ],
    "EfficientDV.keep_duplicates": true,
    "EfficientDV.add_ins_size_channel": true,
    "EfficientDV.intervals_string": "chrM",
    "EfficientDV.cloud_provider_override": "aws",
    "EfficientDV.monitoring_script_input": "s3://ultimagen-workflow-resources-us-east-1/monitor_1.0.sh"
}